# Copy to .secure.deploy.env (gitignored) and fill in. mise loads it only for the infra and deploy tasks, so the
# DigitalOcean token never reaches an interactive shell, and the deploy scripts keep it — and everything else in this
# file — out of Gradle's environment.

# DigitalOcean API token with read/write on droplets and firewalls, read on SSH keys and VPCs. Terraform only.
DIGITALOCEAN_TOKEN=

# user@host of the edge proxy, used as the SSH jump host: ssh -J $EDGE_SSH deploy@<droplet private ip>
EDGE_SSH=

# Private VPC IP of the edge. Firewall source, Caddy's trusted proxy and the relay's second trusted hop.
TF_VAR_edge_private_ip=

# Name of the existing VPC the edge lives in; the droplet joins it.
TF_VAR_vpc_name=

# Name of an SSH key already in the DigitalOcean account (Settings → Security). Its public key is what the deploy user
# gets; Terraform looks it up rather than uploading one, because DO refuses a duplicate.
TF_VAR_ssh_key_name=
