# Copy to .secure.release.env (gitignored) and fill in. Only `mise run build:android:release` loads it. Gradle reads
# these four through the environment and nowhere else; a release build with any of them unset fails naming it.

# Absolute path of the upload keystore, kept outside the repo (e.g. /home/you/.android/act-upload.jks). Play App Signing
# holds the real app signing key; this one only proves uploads come from you.
ACT_UPLOAD_STORE_FILE=
ACT_UPLOAD_STORE_PASSWORD=
ACT_UPLOAD_KEY_ALIAS=
ACT_UPLOAD_KEY_PASSWORD=
