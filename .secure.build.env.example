# Copy to .secure.build.env (gitignored) and fill in. mise loads it for the build, run and deploy tasks — The deploy
# scripts run Gradle with nothing from .secure.deploy.env (lib.sh's `gradle`).

# The ACT integration's Client ID from myanimelist.net/apiconfig. Gradle reads MAL_CLIENT_ID itself, so `mise run
# run:*` is prefilled with it, and it is baked into the public production web bundle, deliberately. Not a secret.
MAL_CLIENT_ID=

# Docker Hub account the act-web and act-relay images are built for and pushed to. `docker login` is done once by
# hand; no registry credential here.
DOCKERHUB_USER=

# Serial of the physical Android device `run:android` installs on and launches. Get it from `adb devices` (USB
# debugging on, or `adb pair`/`adb connect` for wireless). Not a secret, but specific to your machine.
ANDROID_TEST_DEVICE_ID=
